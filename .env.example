# ------------------------------------------------------------
# Coding Assessment Platform — .env
#
# Copy this file to .env and fill in the required values.
# Used by docker-compose.yml for the local / on-premise VM setup.
# ------------------------------------------------------------

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── Judge0 CE ─────────────────────────────────────────────────
# URL of a running Judge0 CE instance.
# Dev: https://ce.judge0.com (public, rate-limited)
# Prod: URL of your self-hosted Judge0 instance
JUDGE0_BASE_URL=https://ce.judge0.com

# ── Auth ──────────────────────────────────────────────────────
# Must be a long, random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-at-least-32-chars-long-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Assessment Rules ──────────────────────────────────────────
SCORE_PASS_THRESHOLD=70
MAX_ATTEMPTS_PER_LEVEL=5

# ── Runtime ───────────────────────────────────────────────────
ENV=production

